{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YOUR_STRONG_SECRET_KEY_MIN_32_CHARACTERS_FOR_HMAC_SHA256",
    "Issuer": "AiDailyExpense",
    "Audience": "AiDailyExpenseUsers",
    "ExpiresInMinutes": 43200
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AiDailyExpenseDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Ai": {
    "Provider": "Gemini",
    "GeminiApiKey": "YOUR_GEMINI_API_KEY",
    "GeminiModel": "gemini-2.0-flash",
    "OpenAiApiKey": "YOUR_OPENAI_API_KEY",
    "OpenAiModel": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": "587",
    "SenderName": "AiDailyExpense",
    "SenderEmail": "your_email@gmail.com",
    "SenderPassword": "your_gmail_app_password"
  },
  "Vault": {
    "MasterKey": "YOUR_VAULT_ENCRYPTION_MASTER_KEY_MIN_32_CHARS"
  }
}

